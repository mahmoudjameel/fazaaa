{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/go",
      "destination": "https://us-central1-fazaproject-c5059.cloudfunctions.net/openQrLink"
    },
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|favicon\\.ico|favicon-.*\\.png|apple-touch-icon\\.png|site\\.webmanifest|fzaeen-logo\\.jpeg|landing-hero\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}